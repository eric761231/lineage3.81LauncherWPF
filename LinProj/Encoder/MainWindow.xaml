<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LinEncoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LinEncoder.ViewModels"
        xmlns:conv="clr-namespace:LinEncoder.Converters"
        Title="Lineage Encoder" Height="934" Width="1300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="20" CaptionHeight="40" NonClientFrameEdges="None" ResizeBorderThickness="8" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:IntToBoolConverter x:Key="IntToBoolConverter"/>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
        <conv:StepStatusMultiConverter x:Key="StepStatusMulti"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="BgColor" Color="#121212"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#7232F2"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#28A745"/>
        <SolidColorBrush x:Key="InputBg" Color="#252525"/>
        <SolidColorBrush x:Key="ToggleTrackOn" Color="#4B20A5"/>

        <!-- Premium Toggle Switch Style (CheckBox) -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitchStyle">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid x:Name="SwitchRoot" Width="40" Height="20" Cursor="Hand">
                                <Border x:Name="Track" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10"/>
                                <Ellipse x:Name="Thumb" Fill="#AAA" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleTrackOn}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          Background="{TemplateBinding Background}" 
                                          Foreground="{TemplateBinding Foreground}"
                                          Grid.Column="2" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="⌵" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{StaticResource InputBg}" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" CornerRadius="0,0,6,6" Margin="0,1,0,0"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- UI Styles -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="8,8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#1AFFFFFF" CornerRadius="12,12,0,0" Padding="15,10">
                                    <ContentPresenter ContentSource="Header" TextElement.FontWeight="Bold" TextElement.Foreground="{StaticResource AccentPurple}"/>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </DockPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="25,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TabPanel 放在上方，去除 Margin/Padding，確保標籤無縫 -->
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" Margin="0" Background="Transparent" Panel.ZIndex="1"/>

                            <!-- 內容區塊（向上拉近標籤） -->
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0" Margin="0,-6,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" BorderThickness="1,1,1,3" BorderBrush="{StaticResource BorderColor}" Margin="0,0,0,0" Background="Transparent" MinWidth="60" Height="28">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 視窗控制按鈕樣式 -->
        <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 關閉按鈕專用 (紫色懸停) -->
        <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7232f2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:EncoderViewModel/>
    </Window.DataContext>

    <Border CornerRadius="20" Background="#121212" BorderBrush="#333" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.6" Direction="270" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 標題列 -->
            <Grid Grid.Row="0" Background="#CC1A1A1A" MouseDown="TitleBar_MouseDown" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="LINEAGE 3.81 PROFESSIONAL ENCODER" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="{StaticResource AccentPurple}" FontSize="14" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" Cursor="Hand"/>
                    <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="Close_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 內容區 -->
            <Grid Grid.Row="1" Margin="6,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="MainTab" Grid.Column="0">
                    <!-- TAB 1: 核心工作區 -->
                    <TabItem Header=" 核心工作區 " Margin="12,1,-12,-1">
                        <StackPanel Margin="4,0,-4,0">
                            <!-- 上半部：伺服器與變身檔綜合設定 -->
                            <GroupBox>
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE83D;" FontSize="16" Margin="0,0,10,0" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                                        <TextBlock Text="伺服器與變身檔設定 (Server &amp; BD Setup)" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="12,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="清單版本：" Grid.Row="0"/>
                                        <TextBox Text="{Binding ListVersion}" Grid.Row="0" Grid.Column="1"/>

                                        <TextBlock Text="更新網址：" Grid.Row="1"/>
                                        <TextBox Text="{Binding ListUpdateUrl}" Grid.Row="1" Grid.Column="1"/>

                                        <Separator Grid.Row="2" Grid.ColumnSpan="2"/>

                                        <TextBlock Text="伺服器選擇：" Grid.Row="3"/>
                                        <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Grid.Row="3" Grid.Column="1">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="伺服器名稱：" Grid.Row="4"/>
                                        <TextBox Text="{Binding SelectedServer.Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1"/>

                                        <TextBlock Text="IP 位址：" Grid.Row="5"/>
                                        <TextBox Text="{Binding SelectedServer.Ip, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1"/>

                                        <TextBlock Text="Port：" Grid.Row="6"/>
                                        <TextBox Text="{Binding SelectedServer.Port, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1"/>
                                    </Grid>

                                    <Grid Grid.Column="1" Margin="5,0,-14,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <!-- 啟用變檔與 PAK 選擇同一行 -->
                                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="13,0,0,5" HorizontalAlignment="Left" Width="323" RenderTransformOrigin="0.494,0.499">
                                            <CheckBox Content="啟用變檔" IsChecked="{Binding SelectedServer.UseBd}" Style="{StaticResource ToggleSwitchStyle}" FontWeight="Bold"/>
                                            <ComboBox ItemsSource="{Binding BdFiles}" SelectedItem="{Binding SelectedServer.BdFile}" Width="192" Margin="5,0,0,0" IsEnabled="{Binding SelectedServer.UseBd}"/>
                                        </StackPanel>

                                        <!-- 加密 txt 選檔與加密打包同一行 -->
                                        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="18,10,0,0" HorizontalAlignment="Left" Width="336">
                                            <TextBlock Text="加密變檔 (.txt)：" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding BdSourceFiles}" SelectedItem="{Binding SelectedBdSourceFile}" Width="145" Margin="5,0,0,0" SelectionChanged="ComboBox_SelectionChanged" IsEnabled="{Binding SelectedServer.UseBd}"/>
                                            <Button Content="生成" Command="{Binding PackagePakCommand}" Width="88" Height="32" Style="{StaticResource ModernButton}" Background="{StaticResource AccentPurple}" IsEnabled="{Binding SelectedServer.UseBd}" Click="Button_Click_1"/>
                                        </StackPanel>

                                        <!-- 啟用伺服器與產生清單移到下方一行 -->
                                        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="14,18,0,0" HorizontalAlignment="Left" Width="307">
                                            <CheckBox Content="啟用此伺服器" IsChecked="{Binding SelectedServer.IsUsed}" Style="{StaticResource ToggleSwitchStyle}" Width="153"/>
                                            <Button Content="產生清單" Command="{Binding GenerateListCommand}"
                                                    Style="{StaticResource ModernButton}" Background="{StaticResource AccentGreen}" Width="144" Height="32"/>
                                        </StackPanel>

                                        <!-- 封包加密／隨機加密：per-server 開關，供 A/B 測試 -->
                                        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="14,10,0,0" HorizontalAlignment="Left" Width="323">
                                            <CheckBox Content="封包加密" IsChecked="{Binding SelectedServer.Encrypt}" Style="{StaticResource ToggleSwitchStyle}" Width="153"/>
                                            <CheckBox Content="隨機加密" IsChecked="{Binding SelectedServer.RandKey}" Style="{StaticResource ToggleSwitchStyle}" Width="153"/>
                                        </StackPanel>

                                        <!-- 變身檔（pak）輸出目錄：可瀏覽選擇，沒記錄過會自動跳瀏覽視窗 -->
                                        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="18,10,0,0" HorizontalAlignment="Left" Width="336">
                                            <TextBlock Text="pak 輸出目錄：" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding BdOutputDir}" Width="145" Margin="5,0,0,0" IsReadOnly="True"/>
                                            <Button Content="瀏覽…" Command="{Binding BrowseBdOutputDirCommand}" Width="88" Height="32" Style="{StaticResource ModernButton}" Margin="5,0,0,0"/>
                                        </StackPanel>

                                        <!-- RSA 金鑰：唯讀顯示目前套用值，按「產生金鑰」整組覆蓋 -->
                                        <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="14,10,0,0" HorizontalAlignment="Left" Width="323">
                                            <TextBlock VerticalAlignment="Center" FontSize="11">
                                                <Run Text="E="/><Run Text="{Binding SelectedServer.E, Mode=OneWay}"/>
                                                <Run Text=" D="/><Run Text="{Binding SelectedServer.D, Mode=OneWay}"/>
                                                <Run Text=" N="/><Run Text="{Binding SelectedServer.N, Mode=OneWay}"/>
                                            </TextBlock>
                                            <Button Content="產生金鑰" Command="{Binding GenerateRsaKeyCommand}" Width="88" Height="32" Style="{StaticResource ModernButton}" Background="{StaticResource AccentPurple}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                            <GroupBox>
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7AD;" FontSize="16" Margin="0,0,10,0" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                                        <TextBlock Text="登入器主程式設定 (Launcher Maker)" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="登入器標題：" Grid.Row="0"/>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>

                                        <TextBlock Text="視窗解析度：" Grid.Row="0" Grid.Column="2" Margin="40,0,10,0"/>
                                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                            <TextBlock Text=" × " Margin="12,0" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        </StackPanel>

                                        <TextBlock Text="清單讀取網址：" Grid.Row="1"/>
                                        <TextBox Text="{Binding List, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,5,19,5"/>

                                        <TextBlock Text="自動更新設定：" Grid.Row="2"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                            <CheckBox Content="啟用自動更新系統" IsChecked="{Binding UseUpdate}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,30,0"/>
                                            <TextBlock Text="更新連結：" IsEnabled="{Binding UseUpdate}" Margin="0,0,10,0"/>
                                            <TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=PropertyChanged}" Width="500" IsEnabled="{Binding UseUpdate}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="外部連結配置 (Optional Links):" Margin="0,12,0,6" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
                                    <ItemsControl ItemsSource="{Binding Links}" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{Binding DisplayIndex, StringFormat=連結 \{0\}}" IsChecked="{Binding Enabled}" Style="{StaticResource ToggleSwitchStyle}"/>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="10,0" Height="26" IsEnabled="{Binding Enabled}"/>
                                                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Height="26" IsEnabled="{Binding Enabled}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,8"/>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="輸出名稱：" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding OutputLauncherName}" Grid.Column="1" Height="36"/>

                                        <TextBlock Text="選用dat：" Grid.Column="2" Margin="50,0,10,0" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding LauncherTemplates}" SelectedItem="{Binding SelectedTemplate}" Grid.Column="3" Height="36"/>

                                        <Button Content="生成登入器" Command="{Binding MakeCommand}" 
                                            Grid.Column="4" Margin="12,0,0,0" Style="{StaticResource ModernButton}" 
                                            Background="{StaticResource AccentPurple}" Height="36" Padding="20,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 下半部：登入器主程式設定 -->
                        </StackPanel>
                    </TabItem>

                    <!-- TAB 3: 補丁產生工具 -->
                    <TabItem Header=" 補丁產生工具 " Margin="13,1,-13,-1">
                        <Grid Margin="12,0,12,0" Height="841">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="87*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GroupBox Margin="0,8,16,8" Grid.ColumnSpan="2">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA6A;" FontSize="16" Margin="0,0,10,0" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                                        <TextBlock Text="補丁封裝與更新產生 (Patcher Maker)" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="來源目錄："/>
                                    <TextBox Text="{Binding PatchSourceDir}" Grid.Column="1" Margin="10,5"
                                             LostFocus="PatchSourceDir_LostFocus"
                                             ToolTip="選擇目錄後會自動列出檔案；手動輸入路徑後請按 Tab 離開欄位以重新整理。"/>
                                    <Button Grid.Column="2" Style="{StaticResource ModernButton}" Background="{StaticResource BorderColor}" Margin="10,0,0,0"
                                            Command="{Binding BrowsePatchSourceDirCommand}" ToolTip="選擇來源目錄">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>

                                    <TextBlock Text="輸出目錄：" Grid.Row="1"/>
                                    <TextBox Text="{Binding PatchOutputDir}" Grid.Row="1" Grid.Column="1" Margin="10,5"/>
                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ModernButton}" Background="{StaticResource BorderColor}" Margin="10,0,0,0"
                                            Command="{Binding BrowsePatchOutputDirCommand}" ToolTip="選擇輸出目錄">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>

                                    <TextBlock Text="下載網址：" Grid.Row="2"/>
                                    <TextBox Text="{Binding PatchBaseUrl}" Grid.Row="2" Grid.Column="1" Margin="10,5" Grid.ColumnSpan="2"/>

                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,30,0,15">
                                        <TextBlock Text="壓縮模式選擇：" Margin="0,0,50,0" FontWeight="Bold" Foreground="White"/>
                                        <RadioButton Content="預設壓縮" IsChecked="{Binding CompressionLevel, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" Margin="0,0,40,0" Foreground="White"/>
                                        <RadioButton Content="極速打包" IsChecked="{Binding CompressionLevel, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}" Margin="0,0,40,0" Foreground="White"/>
                                        <RadioButton Content="最大壓縮" IsChecked="{Binding CompressionLevel, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}" Foreground="White"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                                            <TextBlock Text="檔案總數：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0"/>
                                            <TextBlock Text="{Binding PatchFileCount}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 補丁檔案資訊與進度 (已移至壓縮選項行) -->

                                    <Border Grid.Row="5" Grid.ColumnSpan="3" Background="Black" CornerRadius="10" Padding="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,6">
                                        <DataGrid ItemsSource="{Binding PatchFileRows}" Background="Black" Foreground="White" BorderThickness="0"
                                                  AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="34" CanUserAddRows="False"
                                                  IsReadOnly="True" RowBackground="Black" AlternatingRowBackground="Black">
                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="Black"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Padding" Value="15,10"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="#333333"/>
                                                </Style>
                                                <Style x:Key="PatchGridCellText" TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Background" Value="Black"/>
                                                </Style>
                                            </DataGrid.Resources>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Black"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1E1E1E"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#252525"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="Background" Value="Black"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#333333"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1E1E1E"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="檔案索引" Binding="{Binding Index}" Width="120" ElementStyle="{StaticResource PatchGridCellText}"/>
                                                <DataGridTextColumn Header="相對路徑" Binding="{Binding RelativePath}" Width="*" ElementStyle="{StaticResource PatchGridCellText}"/>
                                                <DataGridTextColumn Header="大小 (KB)" Binding="{Binding SizeKbDisplay}" Width="120" ElementStyle="{StaticResource PatchGridCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="914">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                    <ProgressBar Width="361" Height="18" Minimum="0" Maximum="100" Value="{Binding PatchProgressPercent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="打包進度：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding PatchProgressPercent, StringFormat={}{0:F0}%}" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    <TextBlock Text=" | " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0"/>
                                    <TextBlock Text="{Binding CurrentPatchFile}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Width="220" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text=" (" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding EstimatedRemaining}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Text=")" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Content="產生更新資源" Command="{Binding GeneratePatchCommand}"
                                        Style="{StaticResource ModernButton}" Background="{StaticResource AccentPurple}" Height="36" Padding="24,0" Width="172"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: 補丁上傳 -->
                    <TabItem Header=" 補丁上傳 " Margin="13,1,-13,-1">
                        <Grid Margin="12,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <GroupBox Margin="0,8,0,8" Header="FTP 上傳設定" Foreground="{StaticResource TextSecondary}">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="主機：" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding FtpHost}" Grid.Column="1" Margin="10,5"/>
                                    <TextBlock Text="埠號：" Foreground="White" VerticalAlignment="Center" Grid.Column="2" Margin="16,0,0,0"/>
                                    <TextBox Text="{Binding FtpPort}" Grid.Column="3" Margin="10,5"/>

                                    <TextBlock Text="帳號：" Foreground="White" VerticalAlignment="Center" Grid.Row="1"/>
                                    <TextBox Text="{Binding FtpUsername}" Grid.Row="1" Grid.Column="1" Margin="10,5"/>
                                    <TextBlock Text="密碼：" Foreground="White" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2" Margin="16,0,0,0"/>
                                    <PasswordBox x:Name="FtpPasswordBox" PasswordChanged="FtpPassword_PasswordChanged" Grid.Row="1" Grid.Column="3" Margin="10,5"/>

                                    <TextBlock Text="遠端目錄：" Foreground="White" VerticalAlignment="Center" Grid.Row="2"/>
                                    <TextBox Text="{Binding FtpRemoteDir}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,5"
                                             ToolTip="相對於 FTP 帳號根目錄的路徑，例如 update"/>
                                </Grid>
                            </GroupBox>

                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,12,0,20">
                                <TextBlock Text="{Binding PatchOutputDir, StringFormat=將上傳「補丁產生工具」輸出目錄的內容：{0}}"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                        <ProgressBar Width="361" Height="18" Minimum="0" Maximum="100" Value="{Binding UploadProgressPercent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="上傳進度：" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding UploadProgressPercent, StringFormat={}{0:F0}%}" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBlock Text=" | " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0"/>
                                        <TextBlock Text="{Binding CurrentUploadFile}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Width="220" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text=" (" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding UploadEstimatedRemaining}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock Text=")" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Button Content="上傳補丁" Command="{Binding UploadPatchCommand}"
                                            Style="{StaticResource ModernButton}" Background="{StaticResource AccentPurple}" Height="36" Padding="24,0" Width="172"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- 常駐流程導覽面板：不在 TabControl 裡面，切標籤頁不會影響它 -->
                <Border Grid.Column="1" Margin="8,0,0,0" Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="流程導覽" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,10"/>

                            <!-- 群組 A：建置部署狀態（只有找得到 LinProj 原始碼的開發機才顯示；
                                 純部署／夥伴環境沒有原始碼，整組跟開發者無關的東西直接隱藏，不留提示文字） -->
                            <StackPanel Visibility="{Binding WorkflowStatus.RepoFound, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="建置部署（開發者）" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding WorkflowStatus.EncoderNeedsRebuild, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=Warn}"/>
                                    <TextBlock Grid.Column="1" Text="Encoder 原始碼" Foreground="White" VerticalAlignment="Center"/>
                                </Grid>
                                <Button Content="重新建置 Encoder" Command="{Binding RebuildEncoderCommand}"
                                        HorizontalAlignment="Stretch" Height="28" Margin="18,2,0,8" FontSize="11"
                                        Style="{StaticResource ModernButton}" Background="{StaticResource AccentPurple}"
                                        Visibility="{Binding WorkflowStatus.EncoderNeedsRebuild, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding WorkflowStatus.LauncherNeedsRebuild, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=Warn}"/>
                                    <TextBlock Grid.Column="1" Text="LinLauncher 原始碼" Foreground="White" VerticalAlignment="Center"/>
                                </Grid>
                                <Button Content="重新建置 LinLauncher" Command="{Binding RebuildLauncherCommand}"
                                        HorizontalAlignment="Stretch" Height="28" Margin="18,2,0,8" FontSize="11"
                                        Style="{StaticResource ModernButton}" Background="{StaticResource AccentPurple}"
                                        Visibility="{Binding WorkflowStatus.LauncherNeedsRebuild, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <TextBlock Text="LauncherDll（C++）請自行確認是否已用 Visual Studio 重新編譯，並手動複製到 Core\"
                                           Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,4,0,10"/>
                            </StackPanel>

                            <!-- 群組 B：伺服器／登入器——真正照順序的三步：金鑰 → 清單 → 登入器。
                                 未完成＝灰、已完成＝綠；「2. 產生清單」多比對一個「金鑰是否比清單新」，
                                 是的話代表金鑰重做後沒跟著重新產生清單，橘燈示警而不是單純未完成。 -->
                            <TextBlock Text="伺服器／登入器（依序）" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding WorkflowStatus.KeyGenerated, Converter={StaticResource BoolToStatusBrush}}"/>
                                <TextBlock Grid.Column="1" Text="1. 產生金鑰" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <MultiBinding Converter="{StaticResource StepStatusMulti}">
                                            <Binding Path="WorkflowStatus.ListGenerated"/>
                                            <Binding Path="WorkflowStatus.ListStaleVsKey"/>
                                        </MultiBinding>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="2. 產生清單" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="⚠ 金鑰已重新產生但清單還沒跟著更新，list.txt 裡的金鑰過時了，請重新「產生清單」"
                                       Foreground="#FF851B" FontSize="10" TextWrapping="Wrap" Margin="18,0,0,6"
                                       Visibility="{Binding WorkflowStatus.ListStaleVsKey, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="驗證金鑰" Command="{Binding VerifyListKeysCommand}"
                                    HorizontalAlignment="Stretch" Height="24" Margin="18,0,0,6" FontSize="10"
                                    Style="{StaticResource ModernButton}" Background="{StaticResource BorderColor}"/>
                            <Grid Margin="0,3,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding WorkflowStatus.LauncherExeGenerated, Converter={StaticResource BoolToStatusBrush}}"/>
                                <TextBlock Grid.Column="1" Text="3. 生成登入器" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 變身檔／pak：不需要照順序，異動時單獨處理——只顯示目前有沒有東西、
                                 檔案在哪、下一步是什麼，不套用 1/2/3 那套順序邏輯。 -->
                            <TextBlock Text="變身檔（不需依序，異動時單獨處理）" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,6"/>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding WorkflowStatus.PakGenerated, Converter={StaticResource BoolToStatusBrush}}"/>
                                <TextBlock Grid.Column="1" Text="打包 pak（若有變身檔）" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock Text="異動變身編碼後：切到「變身檔製作」分頁重新打包，下方按鈕可直接開輸出資料夾對照檔案"
                                       Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="18,0,0,4"/>
                            <Button Content="開啟輸出資料夾" Command="{Binding OpenBdOutputDirCommand}"
                                    HorizontalAlignment="Stretch" Height="26" Margin="18,0,0,10" FontSize="11"
                                    Style="{StaticResource ModernButton}" Background="{StaticResource BorderColor}"/>

                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,4,0,10"/>

                            <!-- 群組 C：補丁打包 SOP（獨立分組） -->
                            <TextBlock Text="補丁打包" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding WorkflowStatus.PatchUpToDate, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=Warn}"/>
                                <TextBlock Grid.Column="1" Text="1. 產生更新資源（最新）" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{Binding WorkflowStatus.PatchUploaded, Converter={StaticResource BoolToStatusBrush}}"/>
                                <TextBlock Grid.Column="1" Text="2. 上傳補丁" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>

                            <Button Content="重新整理狀態" Command="{Binding RefreshWorkflowStatusCommand}"
                                    HorizontalAlignment="Stretch" Height="28" Margin="0,14,0,0" FontSize="11"
                                    Style="{StaticResource ModernButton}" Background="{StaticResource BorderColor}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

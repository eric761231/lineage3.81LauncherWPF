<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LinLauncher.Proxy：建置輸出檔名為 LinLauncher.exe（外殼）。
    • AfterTargets=Build 會複製至 Encoder\LinLauncher.dat，供 LinEncoder「產生登入器」當位元組模板。
    • 執行邏輯見 Program.cs：定位 LinLauncher_Environment、套用 *.pending、選用 eat.exe、
      從自身尾端抽出內嵌組態寫入 config.dat、再啟動內層 WPF 登入器。
    • 玩家端部署的是 Encoder 產出之單一 exe + LinLauncher_Environment 目錄；不必單獨發佈本專案原始碼。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LinLauncher.Proxy</RootNamespace>
    <AssemblyName>LinLauncher</AssemblyName>
    <ApplicationIcon>..\LinLauncher\Assets\LinLauncher.ico</ApplicationIcon>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <Target Name="CopyProxyTemplateToEncoder" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildThisFileDirectory)..\Encoder\LinLauncher.dat" SkipUnchangedFiles="false" />
  </Target>

</Project>

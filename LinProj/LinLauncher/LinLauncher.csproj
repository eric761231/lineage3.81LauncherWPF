<Project Sdk="Microsoft.NET.Sdk">

  <!-- 外層啟動器模板 LinLauncher.dat 僅由 LinLauncher.Proxy 建置寫入 Encoder\（勿在此 PostBuild 覆寫）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <ApplicationIcon>Assets\LinLauncher.ico</ApplicationIcon>
    <!-- 必須連結，否則 requireAdministrator 不會生效，CreateProcess 啟動需提權的遊戲時會失敗 740。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\LinLauncher.ico" />
    <None Include="diag_host_trace.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

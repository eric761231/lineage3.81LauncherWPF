<MimirUI>
  <!-- width/height: 視窗基準像素尺寸（未縮放）。refW/refH: 這個版面是照多大的遊戲
       視窗解析度設計的，實際顯示時會依目前遊戲視窗大小等比例縮放。
       posX/posY: 相對遊戲視窗 client area 左上角的偏移量（同 refW/refH 座標系），
       不填就自動置中在遊戲視窗正中央。bg: 背景圖檔名（pak 裡的 entry 名稱），
       3 張卡的外框/標題/「選擇其中一個能力」副標都畫在這張圖裡。900x680（比前一版
       770x555 都加大），讓副標題不會被卡片頂端蓋到，卡片左右也有留白，不會貼死
       視窗邊界。 -->
  <Window width="900" height="680" refW="1153" refH="798" bg="mimir_bg.png"/>

  <!-- 新版 3 張並排完整卡片：3 張共用同一張卡片底圖 option.png（原圖 441x708，
       這裡繪製尺寸 250x410），主題色差異來自各自的圖示（icon）本身顏色，卡片
       外框圖不用做 3 種顏色。左右邊界跟卡片間距都是 35~40px（790->900 加大後
       空間變寬），卡片頂端 y=110，讓出足夠空間給背景圖裡的標題+副標題文字，
       不會被卡片蓋到。
       rect：整張卡範圍（背景圖+命中測試用）。content：圖示+名稱那塊（名稱直接
       顯示「mimir_name+數值」，不再另外顯示一段描述文字，所以這塊不用像以前
       那麼高）。statsRect：這張卡自己的 6 行統計區塊，現在改成單欄由上至下逐行
       （不是兩欄並排）。座標都是視窗座標系裡的絕對座標。選取中/hover 效果不用
       另外準備光暈圖，直接把 option.png 調亮畫一次（DrawImageBrightened，
       MimirPowerOverlay.cpp）。 -->
  <!-- statsRect 的 y 比原本往下移了約 4 行文字高度（4*(15+8)=92px），因為卡片
       美術本身有一條中間分隔線，原本統計區塊卡在那條線上（前 3 行在線上、後
       3 行在線下），整塊移到分隔線下面才不會被線切到。content 高度加回 230
       （名稱+底下的 note 敘述文字兩行都要放，135 只夠放名稱一行，note 那行會被
       裁掉顯示不出來）。 -->
  <Card index="0" rect="40,110,250,410" content="48,122,234,230" statsRect="56,362,234,140" bg="option.png"/>
  <Card index="1" rect="325,110,250,410" content="333,122,234,230" statsRect="341,362,234,140" bg="option.png"/>
  <Card index="2" rect="610,110,250,410" content="618,122,234,230" statsRect="626,362,234,140" bg="option.png"/>

  <!-- 卡片內容用的圖示/名稱/描述大小：圖示 64x64，名稱字級/描述字級沿用先前
       放大 25% 的結果（18->23、14->18）。新版卡片是圖示置中、名稱在圖示下方
       （mimir_name，粗體單行），底下再一行描述（opt.desc，後端直接讀
       mimirwell.note 欄位，例如「支撐命中+2」，見 DrawCardContent），跟舊版
       fallback 用的 DrawDetailContent（圖示靠左）排版不同，但共用這裡設定的
       大小數值。 -->
  <Detail iconSize="64" nameFontSize="23" descFontSize="18" color="FFFFFF"/>
  <!-- 統計文字沿用先前放大 25% 的結果（12->15）。 -->
  <DetailStats fontSize="15" color="FFFFFF"/>

  <!-- 菱形圖繪製邊長跟著 DetailStats fontSize 走（目前 15），不是固定值。 -->
  <Image id="diamond" file="diamond.png"/>

  <!-- 每張卡各自一份統計文字，方便之後個別調整內容（例如「是否可疊加」每張卡
       可能不一樣）；只有「適用」那一行接後端資料（S 包新增的 pvpText 欄位，
       值是 "不限"/"PVP"/"PVE"），dynamic="pvp" 時 value 屬性只是文件用途，
       實際 render 時會被 MimirOption.pvpText 蓋掉。 -->
  <DetailStat card="0" label="效果類型" value="被動效果"/>
  <DetailStat card="0" label="來源" value="日常活躍獎勵"/>
  <DetailStat card="0" label="持續時間" value="24 小時"/>
  <DetailStat card="0" label="是否可疊加" value="否"/>
  <DetailStat card="0" label="冷卻時間" value="無"/>
  <DetailStat card="0" label="適用" dynamic="pvp"/>

  <DetailStat card="1" label="效果類型" value="被動效果"/>
  <DetailStat card="1" label="來源" value="日常活躍獎勵"/>
  <DetailStat card="1" label="持續時間" value="24 小時"/>
  <DetailStat card="1" label="是否可疊加" value="是"/>
  <DetailStat card="1" label="冷卻時間" value="無"/>
  <DetailStat card="1" label="適用" dynamic="pvp"/>

  <DetailStat card="2" label="效果類型" value="被動效果"/>
  <DetailStat card="2" label="來源" value="日常活躍獎勵"/>
  <DetailStat card="2" label="持續時間" value="24 小時"/>
  <DetailStat card="2" label="是否可疊加" value="否"/>
  <DetailStat card="2" label="冷卻時間" value="無"/>
  <DetailStat card="2" label="適用" dynamic="pvp"/>

  <!-- 起始秒數是伺服器送的（S 包最後一個 DWORD），client 收到後每秒往下扣顯示，
       不會自己另外猜時間。倒數在上、確認鈕在下（明確要求的順序）。 -->
  <Countdown rect="40,570,820,16" fontSize="14" color="AAAAAA"
             prefix="選擇將於 " suffix=" 後更新"/>

  <ConfirmButton rect="325,595,250,44" normal="btn_confirm.png"
                 pressed="btn_confirm_pressed.png" fontSize="18" color="FFFFFF" text="選擇此能力"/>

  <!-- 右上角關閉鈕（X）：rect 是 x,y,w,h；w/h 跟素材 btn_close.png 原始尺寸 33x32
       一致，避免程式碼強制縮放造成模糊。往右移，離視窗右邊界更近一點。 -->
  <CloseButton rect="869,15,16,15" normal="btn_close.png"/>

  <!-- iconId 對照不到就用這張 -->
  <DefaultIcon file="icon_default.png"/>
  <!-- 每個 iconId（S 包裡的「選項圖片編號」欄位）對應的圖示檔名，之後照 Java 端
       實際的編號清單增補即可，不用改程式碼、也不用重新編譯 DLL，改完重新執行
       Pack-MimirUiAssets.ps1（帶 -SourceFolder/-Files 參數指到這個資料夾）就好。
       下面 7800~7802 是後端 S 包目前測試用的圖示編號。 -->
  <Icon iconId="1555" file="icon_dmg_reduce.png"/>
  <Icon iconId="7800" file="7800.png"/>
  <Icon iconId="7801" file="7801.png"/>
  <Icon iconId="7802" file="7802.png"/>
</MimirUI>
